@model Shift_Planner_Web.Models.HolidayRequest

@{
    ViewData["Title"] = "Delete Holiday Request";

    var duration =
        (Model.EndDate.Date - Model.StartDate.Date).Days + 1;

    string badgeClass =
        Model.Status switch
        {
            Shift_Planner_Web.Models.HolidayRequestStatus.Pending
                => "bg-warning-subtle text-warning-emphasis border",

            Shift_Planner_Web.Models.HolidayRequestStatus.Approved
                => "bg-success-subtle text-success border",

            Shift_Planner_Web.Models.HolidayRequestStatus.Rejected
                => "bg-danger-subtle text-danger border",

            _ => "bg-secondary-subtle text-secondary border"
        };
}


<!-- HEADER -->

<div class="mb-4">

    <h1 class="fw-bold mb-1">
        Delete Holiday Request
    </h1>

    <p class="text-muted mb-0">
        Confirm that you want to permanently remove this holiday request.
    </p>

</div>


<div class="row justify-content-center">

    <div class="col-xl-8 col-lg-9">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">


                <!-- WARNING -->

                <div class="delete-warning mb-4">

                    <div class="delete-icon">
                        !
                    </div>

                    <div>

                        <div class="fw-semibold mb-1">
                            Delete this holiday request?
                        </div>

                        <div class="text-muted small">
                            This action cannot be undone.
                        </div>

                    </div>

                </div>


                <!-- REQUEST DETAILS -->

                <div class="request-details">

                    <div class="request-header">

                        <div class="employee-avatar">

                            @(string.IsNullOrWhiteSpace(Model.Employee?.Name)
                                ? "?"
                                : Model.Employee.Name
                                    .Substring(0, 1)
                                    .ToUpper())

                        </div>

                        <div>

                            <div class="fw-bold fs-5">
                                @Model.Employee?.Name
                            </div>

                            <div class="text-muted small">
                                Holiday Request
                            </div>

                        </div>

                    </div>


                    <div class="request-detail-grid">

                        <div>

                            <div class="detail-label">
                                Status
                            </div>

                            <div>

                                <span class="badge @badgeClass px-3 py-2">
                                    @Model.Status
                                </span>

                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Duration
                            </div>

                            <div class="fw-semibold">

                                @duration
                                day@(duration == 1 ? "" : "s")

                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Start Date
                            </div>

                            <div class="fw-semibold">
                                @Model.StartDate.ToString("dd MMM yyyy")
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                End Date
                            </div>

                            <div class="fw-semibold">
                                @Model.EndDate.ToString("dd MMM yyyy")
                            </div>

                        </div>

                    </div>

                </div>


                <!-- FORM -->

                <form asp-action="Delete"
                      method="post"
                      class="mt-4">

                    <input asp-for="HolidayRequestID"
                           type="hidden" />


                    <div class="d-flex justify-content-between align-items-center">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-danger px-4">

                            Delete Request

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .delete-warning {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        border: 1px solid #f1c2c2;
        border-radius: 10px;
        background: #fff5f5;
    }

    .delete-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 50%;
        background: #f8d7da;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 20px;
    }

    .request-details {
        border: 1px solid #e5e8ed;
        border-radius: 10px;
        overflow: hidden;
    }

    .request-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        background: #f8f9fa;
        border-bottom: 1px solid #e5e8ed;
    }

    .employee-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        font-weight: 700;
    }

    .request-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

        .request-detail-grid > div {
            padding: 16px 18px;
            border-bottom: 1px solid #e9ecef;
        }

            .request-detail-grid > div:nth-child(odd) {
                border-right: 1px solid #e9ecef;
            }

    .detail-label {
        color: #6c757d;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 5px;
    }

    @@media (max-width: 576px) {

        .request-detail-grid {
            grid-template-columns: 1fr;
        }

            .request-detail-grid > div:nth-child(odd) {
                border-right: 0;
            }
    }

</style>