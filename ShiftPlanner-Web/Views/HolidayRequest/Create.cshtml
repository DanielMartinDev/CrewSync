@model Shift_Planner_Web.Models.HolidayRequest

@{
    ViewData["Title"] = "Request Holiday";
}

<div class="mb-4">

    <h1 class="fw-bold mb-1">
        Request Holiday
    </h1>

    <p class="text-muted mb-0">
        Submit a holiday request for manager approval.
    </p>

</div>


<div class="row justify-content-center">

    <div class="col-xl-7 col-lg-8">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                @if (ViewBag.Error != null)
                {
                    <div class="holiday-error mb-4">

                        <div class="fw-semibold mb-1">
                            Holiday request could not be submitted
                        </div>

                        <div>
                            @ViewBag.Error
                        </div>

                    </div>
                }


                <form asp-action="Create"
                      method="post">

                    <input asp-for="EmployeeID"
                           type="hidden" />


                    <!-- HOLIDAY DATES -->

                    <div class="form-section mb-4">

                        <div class="section-heading mb-3">

                            <h5 class="fw-bold mb-1">
                                Holiday Dates
                            </h5>

                            <p class="text-muted small mb-0">
                                Select the first and last day of your holiday.
                            </p>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="StartDate"
                                       class="form-label fw-semibold">

                                    Start Date

                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="EndDate"
                                       class="form-label fw-semibold">

                                    End Date

                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- APPROVAL INFORMATION -->

                    <div class="approval-info mb-4">

                        <div class="approval-icon">
                            ✓
                        </div>

                        <div>

                            <div class="fw-semibold mb-1">
                                Holiday Approval Process
                            </div>

                            <div class="text-muted small">
                                Your request will be submitted and remain
                                pending until approved or rejected by a manager.
                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- ACTIONS -->

                    <div class="d-flex justify-content-between align-items-center">

                        @if (User.IsInRole("Employee"))
                        {
                            <a asp-controller="EmployeePortal"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>
                        }
                        else
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>
                        }


                        <button type="submit"
                                class="btn btn-primary px-4">

                            Submit Request

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .form-section {
        position: relative;
    }

    .section-heading h5 {
        font-size: 1rem;
    }

    .form-label {
        margin-bottom: 7px;
    }

    .form-control {
        min-height: 44px;
        border-radius: 8px;
    }

    .approval-info {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 18px;
        border: 1px solid #cfe2ff;
        border-radius: 10px;
        background: #f4f8ff;
    }

    .approval-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 10px;
        background: #e2ecff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .holiday-error {
        padding: 13px 15px;
        border-left: 4px solid #dc3545;
        border-radius: 8px;
        background: #fff5f5;
        color: #842029;
        font-size: 14px;
    }

</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}