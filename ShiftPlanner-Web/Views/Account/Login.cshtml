@model ShiftPlanner_Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Sign In - CrewSync</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: radial-gradient( circle at top left, rgba(13, 110, 253, .08), transparent 35% ), #f6f8fb;
            }

            .login-page {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 32px 20px;
            }

            .login-container {
                width: 100%;
                max-width: 430px;
            }

            /* BRAND */

            .login-brand {
                text-align: center;
                margin-bottom: 28px;
            }

            .login-logo {
                width: 58px;
                height: 58px;
                margin: 0 auto 14px;
                border-radius: 16px;
                background: #0d6efd;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
                font-weight: 800;
                box-shadow: 0 8px 20px rgba(13, 110, 253, .22);
            }

            .login-brand-name {
                font-size: 30px;
                line-height: 1.1;
                font-weight: 800;
                color: #172033;
                letter-spacing: -.5px;
            }

            .login-brand-subtitle {
                margin-top: 7px;
                color: #8a93a2;
                font-size: 14px;
            }

            /* CARD */

            .login-card {
                background: #fff;
                border: 1px solid #e1e5eb;
                border-radius: 16px;
                box-shadow: 0 18px 45px rgba(20, 32, 55, .08);
                overflow: hidden;
            }

            .login-card-body {
                padding: 38px;
            }

            .login-heading {
                font-size: 25px;
                font-weight: 750;
                color: #172033;
                margin-bottom: 7px;
                letter-spacing: -.3px;
            }

            .login-description {
                color: #7b8492;
                font-size: 14px;
                line-height: 1.5;
                margin-bottom: 30px;
            }

            /* FORM */

            .login-label {
                color: #30394a;
                font-size: 14px;
                margin-bottom: 7px;
            }

            .login-input {
                min-height: 48px;
                border-color: #d6dbe3;
                border-radius: 9px;
            }

                .login-input:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
                }

                .login-input::placeholder {
                    color: #adb4bf;
                }

            .login-button {
                min-height: 48px;
                border-radius: 9px;
                font-weight: 650;
                margin-top: 4px;
            }

            /* ERROR */

            .login-error {
                border: 0;
                border-left: 4px solid #dc3545;
                background: #fff5f5;
                color: #842029;
                border-radius: 8px;
                font-size: 14px;
                padding: 12px 14px;
            }

            /* FOOTER */

            .security-note {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                margin-top: 25px;
                color: #8a93a2;
                font-size: 12px;
            }

            .login-footer {
                text-align: center;
                margin-top: 18px;
                color: #9aa2ae;
                font-size: 12px;
            }

            @@media (max-width: 480px) {

                .login-page {
                    padding: 20px 15px;
                }

                .login-card-body {
                    padding: 30px 22px;
                }

                .login-brand-name {
                    font-size: 27px;
                }

                .login-logo {
                    width: 54px;
                    height: 54px;
                    font-size: 26px;
                }
            }

    </style>

</head>


<body>

    <div class="login-page">

        <div class="login-container">


            <!-- BRAND -->

            <div class="login-brand">

                <div class="login-logo">
                    C
                </div>

                <div class="login-brand-name">
                    CrewSync
                </div>

                <div class="login-brand-subtitle">
                    Workforce Management Platform
                </div>

            </div>


            <!-- LOGIN CARD -->

            <div class="login-card">

                <div class="login-card-body">


                    <div class="text-center">

                        <h1 class="login-heading">
                            Welcome Back
                        </h1>

                        <p class="login-description">
                            Sign in to access your schedule,
                            employees and workforce tools.
                        </p>

                    </div>


                    @if (ViewBag.Error != null)
                    {
                        <div class="login-error mb-4">

                            @ViewBag.Error

                        </div>
                    }


                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post">


                        <!-- EMAIL -->

                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label fw-semibold login-label">

                                Email Address

                            </label>

                            <input asp-for="Email"
                                   class="form-control login-input"
                                   placeholder="name@company.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PASSWORD -->

                        <div class="mb-4">

                            <label asp-for="Password"
                                   class="form-label fw-semibold login-label">

                                Password

                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control login-input"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- SUBMIT -->

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary login-button">

                                Sign In

                            </button>

                        </div>

                    </form>


                    <div class="security-note">

                        <span>🔒</span>

                        <span>
                            Secure access to your workforce
                        </span>

                    </div>


                </div>

            </div>


            <div class="login-footer">
                CrewSync © 2026
            </div>


        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>