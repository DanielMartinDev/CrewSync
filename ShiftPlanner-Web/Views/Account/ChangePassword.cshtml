@model ShiftPlanner_Web.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">

    <div class="col-xl-6 col-lg-7">

        <!-- HEADER -->

        <div class="text-center mb-4">

            <div class="password-icon mb-3">
                🔐
            </div>

            <h1 class="fw-bold mb-2">
                Welcome to CrewSync
            </h1>

            <p class="text-muted mb-0">
                Before accessing your account, you'll need to create a new password.
            </p>

        </div>


        <!-- PASSWORD CARD -->

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="password-error mb-4">

                        <div class="fw-semibold mb-1">
                            Please check the details below
                        </div>

                        <div>
                            <div asp-validation-summary="All"></div>
                        </div>

                    </div>
                }


                <form asp-action="ChangePassword"
                      method="post">


                    <!-- CURRENT PASSWORD -->

                    <div class="mb-4">

                        <label asp-for="CurrentPassword"
                               class="form-label fw-semibold">

                            Temporary Password

                        </label>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control password-input"
                               autocomplete="current-password"
                               placeholder="Enter your temporary password" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- NEW PASSWORD -->

                    <div class="mb-4">

                        <label asp-for="NewPassword"
                               class="form-label fw-semibold">

                            New Password

                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control password-input"
                               autocomplete="new-password"
                               placeholder="Create a new password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="mb-4">

                        <label asp-for="ConfirmPassword"
                               class="form-label fw-semibold">

                            Confirm New Password

                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control password-input"
                               autocomplete="new-password"
                               placeholder="Enter your new password again" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- REQUIREMENTS -->

                    <div class="password-requirements mb-4">

                        <div class="fw-semibold mb-2">
                            Password Requirements
                        </div>

                        <ul class="mb-0">

                            <li>
                                At least 8 characters
                            </li>

                            <li>
                                Include an uppercase letter
                            </li>

                            <li>
                                Include a number
                            </li>

                            <li>
                                Include a special character
                            </li>

                        </ul>

                    </div>


                    <!-- SUBMIT -->

                    <div class="d-grid">

                        <button type="submit"
                                class="btn btn-primary password-button">

                            Update Password

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .password-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto;
        border-radius: 15px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .password-input {
        min-height: 46px;
        border-radius: 9px;
        border-color: #d6dbe3;
    }

        .password-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .password-requirements {
        padding: 16px 18px;
        border: 1px solid #cfe2ff;
        border-radius: 10px;
        background: #f4f8ff;
        color: #495057;
        font-size: 14px;
    }

        .password-requirements ul {
            padding-left: 20px;
            color: #6c757d;
        }

        .password-requirements li {
            margin-bottom: 4px;
        }

            .password-requirements li:last-child {
                margin-bottom: 0;
            }

    .password-button {
        min-height: 48px;
        border-radius: 9px;
        font-weight: 650;
    }

    .password-error {
        padding: 13px 15px;
        border-left: 4px solid #dc3545;
        border-radius: 8px;
        background: #fff5f5;
        color: #842029;
        font-size: 14px;
    }

        .password-error .validation-summary-errors {
            margin: 0;
        }

        .password-error ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}