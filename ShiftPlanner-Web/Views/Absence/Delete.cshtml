@model Shift_Planner_Web.Models.Absence

@{
    ViewData["Title"] = "Delete Absence";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">
        Delete Absence
    </h1>

    <p class="text-muted mb-0">
        Confirm that you want to delete this absence.
    </p>
</div>

<div class="card border-danger shadow-sm">

    <div class="card-body">

        <div class="alert alert-warning">
            Are you sure you want to delete this absence?
            This action cannot be undone.
        </div>

        <dl class="row mb-4">

            <dt class="col-sm-3">
                Employee
            </dt>

            <dd class="col-sm-9">
                @Model.Employee?.Name
            </dd>

            <dt class="col-sm-3">
                Dates
            </dt>

            <dd class="col-sm-9">
                @Model.StartDate.ToString("dd MMM yyyy")

                @if (Model.EndDate != Model.StartDate)
                {
                    <span>
                        -
                        @Model.EndDate.ToString("dd MMM yyyy")
                    </span>
                }
            </dd>

            <dt class="col-sm-3">
                Type
            </dt>

            <dd class="col-sm-9">
                @Model.Type
            </dd>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-3">
                    Notes
                </dt>

                <dd class="col-sm-9">
                    @Model.Notes
                </dd>
            }

        </dl>

        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="AbsenceID" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Absence
                </button>

            </div>

        </form>

    </div>

</div>