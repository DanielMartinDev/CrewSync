@model Shift_Planner_Web.Models.Absence

@{
    ViewData["Title"] = "Delete Absence";

    var duration =
        (Model.EndDate.ToDateTime(TimeOnly.MinValue) -
         Model.StartDate.ToDateTime(TimeOnly.MinValue)).Days + 1;
}

<div class="mb-4">

    <h1 class="fw-bold mb-1">
        Delete Absence
    </h1>

    <p class="text-muted mb-0">
        Confirm that you want to permanently remove this absence.
    </p>

</div>


<div class="row justify-content-center">

    <div class="col-xl-8 col-lg-9">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">


                <!-- WARNING -->

                <div class="delete-warning mb-4">

                    <div class="delete-icon">
                        !
                    </div>

                    <div>

                        <div class="fw-semibold mb-1">
                            Delete this absence?
                        </div>

                        <div class="text-muted small">
                            This action cannot be undone.
                        </div>

                    </div>

                </div>


                <!-- ABSENCE DETAILS -->

                <div class="absence-details">

                    <div class="detail-row">

                        <div class="detail-label">
                            Employee
                        </div>

                        <div class="detail-value fw-semibold">
                            @Model.Employee?.Name
                        </div>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">
                            Dates
                        </div>

                        <div class="detail-value">

                            @Model.StartDate.ToString("dd MMM yyyy")

                            @if (Model.EndDate != Model.StartDate)
                            {
                                <span class="text-muted">
                                    –
                                    @Model.EndDate.ToString("dd MMM yyyy")
                                </span>
                            }

                        </div>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">
                            Duration
                        </div>

                        <div class="detail-value">

                            <span class="fw-semibold">
                                @duration
                            </span>

                            <span class="text-muted">
                                day@(duration == 1 ? "" : "s")
                            </span>

                        </div>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">
                            Type
                        </div>

                        <div class="detail-value">

                            <span class="badge bg-danger-subtle text-danger border px-3 py-2">
                                @Model.Type
                            </span>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="detail-row">

                            <div class="detail-label">
                                Notes
                            </div>

                            <div class="detail-value">
                                @Model.Notes
                            </div>

                        </div>
                    }

                </div>


                <!-- ACTIONS -->

                <form asp-action="Delete"
                      method="post"
                      class="mt-4">

                    <input type="hidden"
                           asp-for="AbsenceID" />

                    <div class="d-flex justify-content-between align-items-center">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-danger px-4">

                            Delete Absence

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .delete-warning {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        border: 1px solid #f1c2c2;
        border-radius: 10px;
        background: #fff5f5;
    }

    .delete-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 50%;
        background: #f8d7da;
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 20px;
    }

    .absence-details {
        border: 1px solid #e5e8ed;
        border-radius: 10px;
        overflow: hidden;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 20px;
        padding: 14px 16px;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        color: #6c757d;
        font-size: 14px;
        font-weight: 600;
    }

    .detail-value {
        color: #212529;
    }

    @@media (max-width: 576px) {

        .detail-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }
    }

</style>