@using Shift_Planner_Web.Models
@model ShiftPlanner_Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var contractedHours = Model.Employees
        .Sum(e => e.WeeklyHours);

    var hoursDifference = Model.TotalHours - contractedHours;

    var underHoursEmployees = Model.Employees
        .Where(employee =>
            employee.WeeklyHours > 0 &&
            Model.UpcomingShifts
                .Where(s => s.EmployeeID == employee.EmployeeID)
                .Sum(s => s.ShiftHours) < employee.WeeklyHours &&
            Model.UpcomingShifts
                .Any(s => s.EmployeeID == employee.EmployeeID))
        .ToList();

    var noShiftEmployees = Model.NoShiftEmployees;

    var totalAttentionItems =
        Model.OverHoursEmployees.Count +
        underHoursEmployees.Count +
        noShiftEmployees.Count +
        Model.PendingHolidayRequests.Count;
}


<!-- HEADER -->

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Dashboard
        </h1>

        <p class="text-muted mb-0">
            Here's what's happening with your team this week.
        </p>

    </div>

</div>


<!-- KPI CARDS -->

<div class="row g-3 mb-4">

    <!-- TEAM -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-primary small fw-semibold text-uppercase mb-2">
                            Team
                        </div>

                        <div class="fs-2 fw-bold">
                            @Model.EmployeeCount
                        </div>

                        <div class="text-muted small mt-1">
                            Active employees
                        </div>

                    </div>

                    <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                        <span class="text-primary fw-bold">
                            👥
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- SCHEDULED HOURS -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-success small fw-semibold text-uppercase mb-2">
                            Scheduled Hours
                        </div>

                        <div class="fs-2 fw-bold">
                            @Model.TotalHours.ToString("0.0")
                        </div>

                        <div class="text-muted small mt-1">
                            Hours this week
                        </div>

                    </div>

                    <div class="bg-success bg-opacity-10 rounded-3 p-2">
                        <span class="text-success fw-bold">
                            ⏱
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- CONTRACTED HOURS -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-info small fw-semibold text-uppercase mb-2">
                            Contracted Hours
                        </div>

                        <div class="fs-2 fw-bold">
                            @contractedHours.ToString("0.0")
                        </div>

                        <div class="text-muted small mt-1">
                            Weekly contracted hours
                        </div>

                    </div>

                    <div class="bg-info bg-opacity-10 rounded-3 p-2">
                        <span class="text-info fw-bold">
                            📋
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- HOLIDAYS -->

    <div class="col-xl-3 col-md-6">

        <a asp-controller="HolidayRequest"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="text-warning-emphasis small fw-semibold text-uppercase mb-2">
                                Holidays
                            </div>

                            <div class="fs-2 fw-bold text-dark">
                                @Model.PendingHolidayRequests.Count
                            </div>

                            <div class="text-muted small mt-1">
                                Pending requests
                            </div>

                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                            <span class="text-warning-emphasis fw-bold">
                                📅
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </a>

    </div>

</div>


<!-- WEEK SUMMARY -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

            <div>

                <h5 class="fw-bold mb-1">
                    This Week
                </h5>

                <small class="text-muted">

                    Week
                    @System.Globalization.ISOWeek.GetWeekOfYear(Model.WeekStart)

                    ·

                    @Model.WeekStart.ToString("dd MMM yyyy")

                    -

                    @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy")

                </small>

            </div>

            <a asp-controller="Shift"
               asp-action="Index"
               class="btn btn-primary btn-sm mt-3 mt-md-0">

                Manage Schedule

            </a>

        </div>


        <div class="row g-3">

            <div class="col-md-6">

                <div class="border rounded-3 p-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-1">
                                Scheduled
                            </div>

                            <div class="fs-4 fw-bold">
                                @Model.TotalHours.ToString("0.0")
                                <span class="fs-6 fw-normal text-muted">
                                    hrs
                                </span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="border rounded-3 p-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small mb-1">
                                Contracted
                            </div>

                            <div class="fs-4 fw-bold">
                                @contractedHours.ToString("0.0")
                                <span class="fs-6 fw-normal text-muted">
                                    hrs
                                </span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- NEEDS ATTENTION -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-start mb-4">

            <div>

                <h5 class="fw-bold mb-1">
                    Needs Attention
                </h5>

                <small class="text-muted">
                    Items that may need reviewing.
                </small>

            </div>

            @if (totalAttentionItems > 0)
            {
                <span class="badge bg-danger rounded-pill px-3 py-2">
                    @totalAttentionItems
                </span>
            }
            else
            {
                <span class="badge bg-success rounded-pill px-3 py-2">
                    All clear
                </span>
            }

        </div>


        @if (!Model.OverHoursEmployees.Any() &&
             !underHoursEmployees.Any() &&
             !noShiftEmployees.Any() &&
             !Model.PendingHolidayRequests.Any())
        {
            <div class="border rounded-3 p-4 text-center">

                <div class="text-success fs-3 mb-2">
                    ✓
                </div>

                <div class="fw-semibold">
                    Everything looks good
                </div>

                <div class="small text-muted mt-1">
                    No staffing or holiday items require attention.
                </div>

            </div>
        }
        else
        {

            <!-- OVER HOURS -->
            @foreach (var employee in Model.OverHoursEmployees)
            {
                <div class="alert alert-danger d-flex align-items-center py-3 mb-2">

                    <div class="me-3">
                        ⚠
                    </div>

                    <div>

                        <strong>
                            @employee.Name
                        </strong>

                        is over their contracted hours.

                    </div>

                </div>
            }


            <!-- UNDER HOURS -->
            @foreach (var employee in underHoursEmployees)
            {
                var employeeHours = Model.UpcomingShifts
                    .Where(s => s.EmployeeID == employee.EmployeeID)
                    .Sum(s => s.ShiftHours);

                <div class="alert alert-warning d-flex align-items-center py-3 mb-2">

                    <div class="me-3">
                        ⚠
                    </div>

                    <div>

                        <strong>
                            @employee.Name
                        </strong>

                        is scheduled for

                        <strong>
                            @employeeHours.ToString("0.0")
                        </strong>

                        /

                        @employee.WeeklyHours.ToString("0.0")

                        hours.

                    </div>

                </div>
            }


            <!-- NO SHIFTS -->
            @foreach (var employee in noShiftEmployees)
            {
                <div class="alert alert-warning d-flex align-items-center py-3 mb-2">

                    <div class="me-3">
                        ⚠
                    </div>

                    <div>

                        <strong>
                            @employee.Name
                        </strong>

                        has no shifts assigned this week.

                    </div>

                </div>
            }


            <!-- HOLIDAYS -->
            @if (Model.PendingHolidayRequests.Any())
            {
                <a asp-controller="HolidayRequest"
                   asp-action="Index"
                   class="alert alert-info d-flex align-items-center py-3 mb-0 text-decoration-none">

                    <div class="me-3">
                        📅
                    </div>

                    <div>

                        <strong>
                            @Model.PendingHolidayRequests.Count
                        </strong>

                        holiday request(s) are waiting for approval.

                    </div>

                </a>
            }

        }

    </div>

</div>