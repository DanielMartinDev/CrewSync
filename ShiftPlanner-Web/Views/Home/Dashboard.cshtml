@using Shift_Planner_Web.Models
@model ShiftPlanner_Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var contractedHours = Model.Employees
        .Sum(e => e.WeeklyHours);

    var hoursDifference = Model.TotalHours - contractedHours;

    var underHoursEmployees = Model.Employees
        .Where(employee =>
            employee.WeeklyHours > 0 &&
            Model.UpcomingShifts
                .Where(s => s.EmployeeID == employee.EmployeeID)
                .Sum(s => s.ShiftHours) < employee.WeeklyHours &&
            Model.UpcomingShifts
                .Any(s => s.EmployeeID == employee.EmployeeID))
        .ToList();

    var noShiftEmployees = Model.NoShiftEmployees;

    var totalAttentionItems =
        Model.OverHoursEmployees.Count +
        underHoursEmployees.Count +
        noShiftEmployees.Count +
        Model.PendingHolidayRequests.Count;
}

<!-- Header -->

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            Dashboard
        </h1>

        <p class="text-muted mb-0">
            Here's what's happening with your team this week.
        </p>
    </div>

</div>


<!-- KPI CARDS -->

<div class="row g-3 mb-4">

    <!-- Employees -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-primary small fw-semibold mb-2">
                    TEAM
                </div>

                <h2 class="fw-bold mb-1">
                    @Model.EmployeeCount
                </h2>

                <div class="text-muted small">
                    Active employees
                </div>

            </div>

        </div>

    </div>


    <!-- Scheduled hours -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-success small fw-semibold mb-2">
                    SCHEDULED HOURS
                </div>

                <h2 class="fw-bold mb-1">
                    @Model.TotalHours.ToString("0.0")
                </h2>

                <div class="text-muted small">
                    Hours scheduled this week
                </div>

            </div>

        </div>

    </div>


    <!-- Contracted hours -->

    <div class="col-xl-3 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body">

                <div class="text-info small fw-semibold mb-2">
                    CONTRACTED HOURS
                </div>

                <h2 class="fw-bold mb-1">
                    @contractedHours.ToString("0.0")
                </h2>

                <div class="text-muted small">
                    Total weekly contracted hours
                </div>

            </div>

        </div>

    </div>


    <!-- Holidays -->

    <div class="col-xl-3 col-md-6">

        <a asp-controller="HolidayRequest"
           asp-action="Index"
           class="text-decoration-none">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-warning-emphasis small fw-semibold mb-2">
                        HOLIDAYS
                    </div>

                    <h2 class="fw-bold mb-1 text-dark">
                        @Model.PendingHolidayRequests.Count
                    </h2>

                    <div class="text-muted small">
                        Pending requests
                    </div>

                </div>

            </div>

        </a>

    </div>

</div>


<!-- WEEK SUMMARY -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h5 class="fw-bold mb-1">
                    This Week
                </h5>

                <small class="text-muted">
                    Week @System.Globalization.ISOWeek.GetWeekOfYear(Model.WeekStart)
                    · @Model.WeekStart.ToString("dd MMM yyyy")
                    -
                    @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy")
                </small>
            </div>

            <a asp-controller="Shift"
               asp-action="Index"
               class="btn btn-primary btn-sm">
                Manage Schedule
            </a>

        </div>

        <div class="row g-3">

            <div class="col-md-6">

                <div class="p-3 bg-light rounded">

                    <div class="text-muted small mb-1">
                        Scheduled
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalHours.ToString("0.0") hrs
                    </div>

                </div>

            </div>

            <div class="col-md-6">

                <div class="p-3 bg-light rounded">

                    <div class="text-muted small mb-1">
                        Contracted
                    </div>

                    <div class="fs-4 fw-bold">
                        @contractedHours.ToString("0.0") hrs
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- NEEDS ATTENTION -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h5 class="fw-bold mb-1">
                    Needs Attention
                </h5>

                <small class="text-muted">
                    Items that may need reviewing.
                </small>

            </div>

            @if (totalAttentionItems > 0)
            {
                <span class="badge bg-danger">
                    @totalAttentionItems
                </span>
            }

        </div>


        @if (!Model.OverHoursEmployees.Any() &&
             !underHoursEmployees.Any() &&
             !noShiftEmployees.Any() &&
             !Model.PendingHolidayRequests.Any())
        {
            <div class="alert alert-success mb-0">

                <strong>Everything looks good.</strong>

                <div class="small mt-1">
                    No staffing or holiday items require attention.
                </div>

            </div>
        }
        else
        {

            <!-- Over hours -->
            @foreach (var employee in Model.OverHoursEmployees)
            {
                <div class="alert alert-danger py-2 mb-2">

                    <strong>@employee.Name</strong>

                    is over their contracted hours.

                </div>
            }


            <!-- Under hours -->
            @foreach (var employee in underHoursEmployees)
            {
                var employeeHours = Model.UpcomingShifts
                    .Where(s => s.EmployeeID == employee.EmployeeID)
                    .Sum(s => s.ShiftHours);

                <div class="alert alert-warning py-2 mb-2">

                    <strong>@employee.Name</strong>

                    is scheduled for
                    <strong>@employeeHours.ToString("0.0")</strong>
                    /
                    @employee.WeeklyHours.ToString("0.0")
                    hours.

                </div>
            }


            <!-- No shifts -->
            @foreach (var employee in noShiftEmployees)
            {
                <div class="alert alert-warning py-2 mb-2">

                    <strong>@employee.Name</strong>

                    has no shifts assigned this week.

                </div>
            }


            <!-- Holidays -->
            @if (Model.PendingHolidayRequests.Any())
            {
                <a asp-controller="HolidayRequest"
                   asp-action="Index"
                   class="alert alert-info py-2 mb-0 text-decoration-none d-block">

                    <strong>
                        @Model.PendingHolidayRequests.Count
                    </strong>

                    holiday request(s) are waiting for approval.

                </a>
            }

        }

    </div>

</div>