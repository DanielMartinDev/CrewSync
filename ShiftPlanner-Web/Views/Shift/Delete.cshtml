@model Shift_Planner_Web.Models.Shift

@{
    ViewData["Title"] = "Delete Shift";
}

<div class="mb-4">

    <h1 class="fw-bold mb-1">
        Delete Shift
    </h1>

    <p class="text-muted mb-0">
        Review the shift details before permanently removing it.
    </p>

</div>


<div class="row justify-content-center">

    <div class="col-xl-7 col-lg-8">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                <!-- WARNING -->

                <div class="delete-warning mb-4">

                    <div class="warning-icon">
                        !
                    </div>

                    <div>

                        <div class="fw-bold mb-1">
                            This action cannot be undone
                        </div>

                        <div>
                            Deleting this shift will permanently remove it
                            from the schedule.
                        </div>

                    </div>

                </div>


                <!-- SHIFT DETAILS -->

                <div class="mb-4">

                    <div class="section-heading mb-3">

                        <h5 class="fw-bold mb-1">
                            Shift Details
                        </h5>

                        <p class="text-muted small mb-0">
                            Confirm this is the shift you want to delete.
                        </p>

                    </div>


                    <div class="shift-details">

                        <div class="detail-item">

                            <div class="detail-label">
                                Employee
                            </div>

                            <div class="detail-value fw-semibold">
                                @Model.Employee?.Name
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                Date
                            </div>

                            <div class="detail-value">
                                @Model.StartTime.ToString("dd MMM yyyy")
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                Start Time
                            </div>

                            <div class="detail-value">
                                @Model.StartTime.ToString("HH:mm")
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                End Time
                            </div>

                            <div class="detail-value">
                                @Model.EndTime.ToString("HH:mm")
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                Shift Duration
                            </div>

                            <div class="detail-value">
                                @Model.ShiftHours hrs
                            </div>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- ACTIONS -->

                <form asp-action="Delete"
                      method="post">

                    <input asp-for="ShiftID"
                           type="hidden" />

                    <div class="d-flex justify-content-between align-items-center">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-danger px-4">

                            Delete Shift

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 18px;
        border: 1px solid #f1b0b7;
        border-radius: 10px;
        background: #fff5f5;
        color: #842029;
        font-size: 14px;
    }

    .warning-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 10px;
        background: #f8d7da;
        color: #b02a37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 800;
    }

    .section-heading h5 {
        font-size: 1rem;
    }

    .shift-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border: 1px solid #e9ecef;
        border-radius: 10px;
        overflow: hidden;
    }

    .detail-item {
        padding: 16px;
        background: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
    }

        .detail-item:nth-child(odd) {
            border-right: 1px solid #e9ecef;
        }

        .detail-item:last-child {
            grid-column: 1 / -1;
            border-bottom: 0;
            border-right: 0;
        }

    .detail-label {
        font-size: 12px;
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
    }

    .detail-value {
        font-size: 15px;
    }

    @@media (max-width: 576px) {

        .shift-details {
            grid-template-columns: 1fr;
        }

        .detail-item:nth-child(odd) {
            border-right: 0;
        }

        .detail-item {
            border-bottom: 1px solid #e9ecef;
        }

            .detail-item:last-child {
                grid-column: auto;
                border-bottom: 0;
            }
    }

</style>