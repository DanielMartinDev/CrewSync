@model Shift_Planner_Web.Models.Shift

@{
    ViewData["Title"] = "Edit Shift";
}

<div class="mb-4">

    <h1 class="fw-bold mb-1">
        Edit Shift
    </h1>

    <p class="text-muted mb-0">
        Update shift details, working hours and assigned employee.
    </p>

</div>


<div class="row justify-content-center">

    <div class="col-xl-8 col-lg-9">

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4 p-md-5">

                @if (ViewBag.Error != null)
                {
                    <div class="shift-error mb-4">

                        <div class="fw-semibold mb-1">
                            Unable to save shift
                        </div>

                        <div>
                            @ViewBag.Error
                        </div>

                    </div>
                }


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="shift-validation mb-4">

                        <div class="fw-semibold mb-1">
                            Please check the details below
                        </div>

                        <div asp-validation-summary="All"></div>

                    </div>
                }


                <form asp-action="Edit"
                      method="post">

                    <input asp-for="ShiftID"
                           type="hidden" />


                    <!-- EMPLOYEE -->

                    <div class="form-section mb-4">

                        <div class="section-heading mb-3">

                            <h5 class="fw-bold mb-1">
                                Employee
                            </h5>

                            <p class="text-muted small mb-0">
                                Select the employee assigned to this shift.
                            </p>

                        </div>


                        <label asp-for="EmployeeID"
                               class="form-label fw-semibold">

                            Employee

                        </label>

                        <select asp-for="EmployeeID"
                                class="form-select"
                                asp-items="ViewBag.Employees">

                            <option value="">
                                Select Employee
                            </option>

                        </select>

                        <span asp-validation-for="EmployeeID"
                              class="text-danger small">
                        </span>

                    </div>


                    <hr class="my-4" />


                    <!-- SHIFT TIMES -->

                    <div class="form-section mb-4">

                        <div class="section-heading mb-3">

                            <h5 class="fw-bold mb-1">
                                Shift Times
                            </h5>

                            <p class="text-muted small mb-0">
                                Update when the employee starts and finishes.
                            </p>

                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="StartTime"
                                       class="form-label fw-semibold">

                                    Shift Start

                                </label>

                                <input asp-for="StartTime"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="StartTime"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="EndTime"
                                       class="form-label fw-semibold">

                                    Shift End

                                </label>

                                <input asp-for="EndTime"
                                       type="datetime-local"
                                       class="form-control" />

                                <span asp-validation-for="EndTime"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- BREAK -->

                    <div class="form-section mb-4">

                        <div class="section-heading mb-3">

                            <h5 class="fw-bold mb-1">
                                Break
                            </h5>

                            <p class="text-muted small mb-0">
                                Update the total unpaid break duration.
                            </p>

                        </div>


                        <label asp-for="BreakDuration"
                               class="form-label fw-semibold">

                            Break Duration (Minutes)

                        </label>

                        <div class="input-group">

                            <input asp-for="BreakDuration"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="0" />

                            <span class="input-group-text">
                                minutes
                            </span>

                        </div>

                        <span asp-validation-for="BreakDuration"
                              class="text-danger small">
                        </span>

                    </div>


                    <hr class="my-4" />


                    <!-- NOTES -->

                    <div class="form-section mb-4">

                        <div class="section-heading mb-3">

                            <h5 class="fw-bold mb-1">
                                Shift Notes
                            </h5>

                            <p class="text-muted small mb-0">
                                Add or update any information about this shift.
                            </p>

                        </div>


                        <label asp-for="Notes"
                               class="form-label fw-semibold">

                            Notes

                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Optional notes for this shift..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- SCHEDULING RULES -->

                    <div class="rules-panel mb-4">

                        <div class="rules-icon">
                            ✓
                        </div>

                        <div>

                            <div class="fw-semibold mb-2">
                                Scheduling Rules
                            </div>

                            <ul class="mb-0">

                                <li>
                                    Availability validation is checked automatically.
                                </li>

                                <li>
                                    Holiday conflicts are prevented automatically.
                                </li>

                                <li>
                                    Contracted hours are monitored during scheduling.
                                </li>

                            </ul>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <!-- ACTIONS -->

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                        <a asp-action="Delete"
                           asp-route-id="@Model.ShiftID"
                           class="btn btn-outline-danger">

                            Delete Shift

                        </a>


                        <div class="d-flex gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                Save Changes

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<style>

    .form-section {
        position: relative;
    }

    .section-heading h5 {
        font-size: 1rem;
    }

    .form-label {
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 8px;
    }

    textarea.form-control {
        min-height: 110px;
    }

    .input-group .form-control {
        border-radius: 8px 0 0 8px;
    }

    .input-group-text {
        border-radius: 0 8px 8px 0;
        background: #f8f9fa;
    }

    .shift-error,
    .shift-validation {
        padding: 14px 16px;
        border-radius: 8px;
        font-size: 14px;
    }

    .shift-error,
    .shift-validation {
        border-left: 4px solid #dc3545;
        background: #fff5f5;
        color: #842029;
    }

        .shift-validation ul {
            margin-bottom: 0;
            padding-left: 18px;
        }

    .rules-panel {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 18px;
        border: 1px solid #cfe2ff;
        border-radius: 10px;
        background: #f4f8ff;
        color: #495057;
        font-size: 14px;
    }

    .rules-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 10px;
        background: #e2ecff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .rules-panel ul {
        padding-left: 20px;
        margin-bottom: 0;
        color: #6c757d;
    }

    .rules-panel li {
        margin-bottom: 4px;
    }

        .rules-panel li:last-child {
            margin-bottom: 0;
        }

</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}