@model List<Shift_Planner_Web.Models.Shift>

@{
    ViewData["Title"] = "Schedule";

    var today = DateTime.Today;

    var weekStart = ViewBag.WeekStart != null
        ? (DateTime)ViewBag.WeekStart
        : today.AddDays(-(((int)today.DayOfWeek + 6) % 7));

    var weekEnd = weekStart.AddDays(6);

    var totalShifts = Model.Count;

    var totalHours = Model.Sum(s => s.ShiftHours);

    var absences =
        ViewBag.Absences as List<Shift_Planner_Web.Models.Absence>
        ?? new List<Shift_Planner_Web.Models.Absence>();

    var holidays =
        ViewBag.Holidays as List<Shift_Planner_Web.Models.HolidayRequest>
        ?? new List<Shift_Planner_Web.Models.HolidayRequest>();

    var employeeCount = Model
        .Select(s => s.EmployeeID)
        .Distinct()
        .Count();

    var employees = Model
        .Where(s => s.Employee != null)
        .GroupBy(s => new
        {
            s.EmployeeID,
            Name = s.Employee!.Name
        })
        .OrderBy(e => e.Key.Name)
        .ToList();
}


<!-- HEADER -->

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 no-print">

    <div>

        <h1 class="fw-bold mb-1">
            Schedule
        </h1>

        <p class="text-muted mb-0">
            Plan and manage your team's weekly rota.
        </p>

    </div>


    <div class="d-flex flex-wrap gap-2 mt-3 mt-lg-0">

        <a asp-action="Index"
           asp-route-weekStart="@weekStart.AddDays(-7).ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">

            ← Previous Week

        </a>

        <a asp-action="Index"
           asp-route-weekStart="@weekStart.AddDays(7).ToString("yyyy-MM-dd")"
           class="btn btn-primary">

            Next Week →

        </a>

        <button type="button"
                class="btn btn-outline-primary no-print"
                onclick="printRota()">

            🖨 Print Rota

        </button>

    </div>

</div>


<!-- SUMMARY CARDS -->

<div class="row g-3 mb-4 no-print">

    <div class="col-lg-4 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-primary small fw-semibold text-uppercase mb-2">
                            Shifts
                        </div>

                        <div class="fs-2 fw-bold">
                            @totalShifts
                        </div>

                        <div class="text-muted small mt-1">
                            Scheduled this week
                        </div>

                    </div>

                    <div class="schedule-summary-icon bg-primary bg-opacity-10 text-primary">
                        📅
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-lg-4 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-success small fw-semibold text-uppercase mb-2">
                            Hours
                        </div>

                        <div class="fs-2 fw-bold">
                            @totalHours.ToString("0.0")
                        </div>

                        <div class="text-muted small mt-1">
                            Total scheduled hours
                        </div>

                    </div>

                    <div class="schedule-summary-icon bg-success bg-opacity-10 text-success">
                        ⏱
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="col-lg-4 col-md-6">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-info small fw-semibold text-uppercase mb-2">
                            Team
                        </div>

                        <div class="fs-2 fw-bold">
                            @employeeCount
                        </div>

                        <div class="text-muted small mt-1">
                            Employees scheduled
                        </div>

                    </div>

                    <div class="schedule-summary-icon bg-info bg-opacity-10 text-info">
                        👥
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- WEEK HEADER -->

<div class="card border-0 shadow-sm mb-4 no-print">

    <div class="card-body p-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">

            <div>

                <div class="d-flex align-items-center gap-2 mb-1">

                    <h4 class="fw-bold mb-0">
                        Weekly Rota
                    </h4>

                    <span class="badge bg-primary-subtle text-primary border">
                        Week @System.Globalization.ISOWeek.GetWeekOfYear(weekStart)
                    </span>

                </div>

                <div class="text-muted">
                    @weekStart.ToString("dd MMM yyyy")
                    -
                    @weekEnd.ToString("dd MMM yyyy")
                </div>

            </div>

        </div>

    </div>

</div>


<!-- WEEKLY ROTA -->

<div class="card border-0 shadow-sm">

    <div class="table-responsive">

        <table class="table align-middle mb-0 schedule-table">

            <thead class="table-light">

                <tr>

                    <th class="employee-column">
                        Employee
                    </th>


                    @for (int i = 0; i < 7; i++)
                    {
                        var day = weekStart.AddDays(i);

                        var isToday =
                            day.Date == today.Date;

                        <th class="text-center schedule-day @(isToday ? "today-column" : "")">

                            <div class="fw-semibold">
                                @day.ToString("ddd")
                            </div>

                            <small class="text-muted">
                                @day.ToString("dd MMM")
                            </small>

                            @if (isToday)
                            {
                                <div class="mt-1">
                                    <span class="badge bg-primary">
                                        Today
                                    </span>
                                </div>
                            }

                        </th>
                    }


                    <th class="text-center total-column">
                        Total
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (!employees.Any())
                {
                    <tr>

                        <td colspan="9"
                            class="text-center py-5">

                            <div class="schedule-empty-state">

                                <div class="fs-1 mb-2">
                                    📅
                                </div>

                                <div class="fw-semibold mb-1">
                                    No shifts scheduled
                                </div>

                                <div class="text-muted small">
                                    There are no shifts in this week's rota yet.
                                </div>

                            </div>

                        </td>

                    </tr>
                }
                else
                {

                    @foreach (var employeeGroup in employees)
                    {
                        var employeeId =
                            employeeGroup.Key.EmployeeID;

                        var employeeName =
                            employeeGroup.Key.Name;

                        var employeeShifts = Model
                            .Where(s => s.EmployeeID == employeeId)
                            .ToList();

                        var employeeHours =
                            employeeShifts.Sum(s => s.ShiftHours);


                        <tr>


                            <!-- EMPLOYEE -->

                            <td class="employee-column">

                                <div class="d-flex align-items-center gap-2">

                                    <div class="employee-avatar">

                                        @(string.IsNullOrWhiteSpace(employeeName)
                                            ? "?"
                                            : employeeName
                                                .Substring(0, 1)
                                                .ToUpper())

                                    </div>

                                    <div class="fw-semibold">
                                        @employeeName
                                    </div>

                                </div>

                            </td>


                            <!-- DAYS -->
                            @for (int i = 0; i < 7; i++)
                            {
                                var day =
                                    weekStart.AddDays(i);

                                var isToday =
                                    day.Date == today.Date;


                                var shift = employeeShifts
                                    .FirstOrDefault(s =>
                                        s.StartTime.Date == day.Date);


                                var absence =
                                    absences.FirstOrDefault(a =>
                                        a.EmployeeID == employeeId &&
                                        DateOnly.FromDateTime(day.Date) >=
                                            a.StartDate &&
                                        DateOnly.FromDateTime(day.Date) <=
                                            a.EndDate);


                                var holiday =
                                    holidays.FirstOrDefault(h =>
                                        h.EmployeeID == employeeId &&
                                        h.Status ==
                                            Shift_Planner_Web.Models.HolidayRequestStatus.Approved &&
                                        day.Date >= h.StartDate.Date &&
                                        day.Date <= h.EndDate.Date);


                                <td class="text-center schedule-cell @(isToday ? "today-column" : "")">


                                    @if (absence != null)
                                    {
                                        <!-- ABSENCE -->

                                        <div class="empty-schedule-cell absence-cell">

                                            <span class="badge bg-danger">
                                                Absent
                                            </span>

                                            <small class="d-block text-muted mt-1">
                                                @absence.Type
                                            </small>

                                        </div>
                                    }


                                    else if (holiday != null)
                                    {
                                        <!-- HOLIDAY -->

                                        <div class="empty-schedule-cell holiday-cell">

                                            <span class="badge bg-warning text-dark">
                                                Holiday
                                            </span>

                                        </div>
                                    }


                                    else if (shift != null)
                                    {
                                        <!-- SHIFT -->

                                        <a asp-action="Edit"
                                           asp-route-id="@shift.ShiftID"
                                           class="text-decoration-none">

                                            <div class="shift-card">

                                                <div class="fw-semibold text-dark shift-time">

                                                    @shift.StartTime.ToString("HH:mm")
                                                    -
                                                    @shift.EndTime.ToString("HH:mm")

                                                </div>

                                                <div class="small text-muted">

                                                    @shift.ShiftHours.ToString("0.0")
                                                    hrs

                                                </div>


                                                @if (!string.IsNullOrWhiteSpace(shift.Notes))
                                                {
                                                    <div class="small fw-semibold text-dark mt-1 shift-note">

                                                        @shift.Notes

                                                    </div>
                                                }

                                            </div>

                                        </a>
                                    }


                                    else
                                    {
                                        <!-- OFF -->

                                        <a asp-action="Create"
                                           asp-route-employeeId="@employeeId"
                                           asp-route-date="@day.ToString("yyyy-MM-dd")"
                                           class="empty-schedule-cell text-decoration-none">

                                            <span class="text-muted">
                                                Off
                                            </span>

                                            <span class="add-shift-text">
                                                + Add shift
                                            </span>

                                        </a>
                                    }

                                </td>
                            }


                            <!-- TOTAL -->

                            <td class="text-center total-column">

                                <span class="hours-badge">

                                    @employeeHours.ToString("0.0")
                                    <small>hrs</small>

                                </span>

                            </td>

                        </tr>
                    }

                }

            </tbody>

        </table>

    </div>


    <script>

            function printRota() {

                setTimeout(function () {

                    window.print();

                }, 100);

            }

    </script>

</div>


<style>

    /* ========================================
           SUMMARY ICONS
        ======================================== */

    .schedule-summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }


    /* ========================================
           SCHEDULE TABLE
        ======================================== */

    .schedule-table {
        min-width: 1100px;
    }

    .employee-column {
        min-width: 190px;
        position: sticky;
        left: 0;
        background: #ffffff;
        z-index: 2;
    }

    thead .employee-column {
        z-index: 3;
    }

    .schedule-day {
        min-width: 125px;
        vertical-align: middle;
    }

    .schedule-cell {
        height: 105px;
        min-width: 125px;
        padding: 8px;
    }

    .total-column {
        min-width: 85px;
    }


    /* ========================================
           EMPLOYEE
        ======================================== */

    .employee-avatar {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
    }


    /* ========================================
           TODAY
        ======================================== */

    .today-column {
        background-color: rgba(13, 110, 253, 0.045);
    }

    thead .today-column {
        background-color: rgba(13, 110, 253, 0.10);
    }


    /* ========================================
           SHIFT CARDS
        ======================================== */

    .shift-card {
        background-color: #edf4ff;
        border: 1px solid #d9e7ff;
        border-radius: 9px;
        padding: 10px 8px;
        min-height: 72px;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

        .shift-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 14px rgba(13, 110, 253, 0.12);
            border-color: #bcd4ff;
        }

    .shift-time {
        font-size: 14px;
    }

    .shift-note {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ========================================
           EMPTY CELLS
        ======================================== */

    .empty-schedule-cell {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 80px;
        border-radius: 9px;
        transition: background-color .15s ease, transform .15s ease;
    }

        .empty-schedule-cell:hover {
            background-color: rgba(13, 110, 253, 0.06);
        }

    .add-shift-text {
        display: none;
        font-size: 0.75rem;
        font-weight: 600;
        color: #0d6efd;
        margin-top: 4px;
    }

    .empty-schedule-cell:hover .add-shift-text {
        display: block;
    }

    .absence-cell,
    .holiday-cell {
        cursor: default;
    }


    /* ========================================
           TOTAL HOURS
        ======================================== */

    .hours-badge {
        display: inline-flex;
        align-items: baseline;
        gap: 3px;
        padding: 7px 10px;
        border-radius: 8px;
        background: #eef8f1;
        color: #198754;
        font-weight: 700;
        font-size: 14px;
    }

        .hours-badge small {
            font-weight: 500;
            font-size: 11px;
        }


    /* ========================================
           EMPTY STATE
        ======================================== */

    .schedule-empty-state {
        padding: 20px;
    }


    /* ========================================
           PRINT
        ======================================== */

    @@media print {

        @@page {
            size: landscape;
            margin: 10mm;
        }

        body {
            background: white !important;
            font-size: 12px;
        }

        .no-print {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .schedule-table {
            width: 100% !important;
            min-width: 0 !important;
            table-layout: fixed;
        }

        .employee-column {
            position: static !important;
            min-width: 140px !important;
            width: 140px;
        }

        .schedule-day {
            min-width: 0 !important;
            width: auto;
        }

        .schedule-cell {
            height: 75px !important;
            min-width: 0 !important;
            padding: 6px !important;
        }

        .employee-avatar {
            display: none !important;
        }

        .shift-card {
            background: white !important;
            border: 1px solid #333 !important;
            border-radius: 4px !important;
            padding: 6px !important;
            box-shadow: none !important;
        }

            .shift-card:hover {
                transform: none !important;
                box-shadow: none !important;
            }

        .today-column {
            background: white !important;
        }

        .empty-schedule-cell {
            min-height: 50px !important;
            color: #555 !important;
        }

        .add-shift-text {
            display: none !important;
        }

        a {
            color: inherit !important;
            text-decoration: none !important;
        }

        .badge {
            border: 1px solid #333 !important;
            background: white !important;
            color: black !important;
        }

        .hours-badge {
            background: white !important;
            color: black !important;
            border: 1px solid #333 !important;
        }

        .table {
            border-collapse: collapse !important;
        }

            .table th,
            .table td {
                border: 1px solid #999 !important;
            }
    }

</style>