@model Shift_Planner_Web.Models.Employee

@{
    ViewData["Title"] = "Employee Profile";

    string status;
    string badgeClass;

    if (Model.ScheduledHours == 0)
    {
        status = "No Shifts";
        badgeClass = "bg-secondary-subtle text-secondary border";
    }
    else if (Model.ScheduledHours > Model.WeeklyHours)
    {
        status = "Over Contract";
        badgeClass = "bg-danger-subtle text-danger border";
    }
    else if (Model.Utilisation >= 90)
    {
        status = "Fully Scheduled";
        badgeClass = "bg-success-subtle text-success border";
    }
    else
    {
        status = "Under Hours";
        badgeClass = "bg-warning-subtle text-warning-emphasis border";
    }

    var upcomingShifts = Model.Shifts
        .Where(s => s.StartTime >= DateTime.Today)
        .OrderBy(s => s.StartTime)
        .ToList();
}


<!-- PROFILE HEADER -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

            <div class="d-flex align-items-center gap-3">

                <div class="employee-profile-avatar">

                    @(string.IsNullOrWhiteSpace(Model.Name)
                        ? "?"
                        : Model.Name.Substring(0, 1).ToUpper())

                </div>

                <div>

                    <h1 class="fw-bold mb-1">
                        @Model.Name
                    </h1>

                    <div class="text-muted">

                        @Model.Role.ToString().Replace("_", " ")

                        <span class="mx-1">•</span>

                        Started
                        @Model.StartDate.ToString("dd MMM yyyy")

                    </div>

                </div>

            </div>


            <span class="badge @badgeClass px-3 py-2">

                @status

            </span>

        </div>

    </div>

</div>


<!-- SUMMARY CARDS -->

<div class="row g-3 mb-4">

    <div class="col-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="text-muted small fw-semibold text-uppercase mb-2">
                    Contract Hours
                </div>

                <div class="fs-2 fw-bold">
                    @Model.WeeklyHours
                </div>

                <div class="text-muted small mt-1">
                    Hours per week
                </div>

            </div>

        </div>

    </div>


    <div class="col-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="text-muted small fw-semibold text-uppercase mb-2">
                    Scheduled
                </div>

                <div class="fs-2 fw-bold">
                    @Model.ScheduledHours
                </div>

                <div class="text-muted small mt-1">
                    Hours scheduled
                </div>

            </div>

        </div>

    </div>


    <div class="col-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="text-muted small fw-semibold text-uppercase mb-2">
                    Remaining
                </div>

                <div class="fs-2 fw-bold">
                    @Model.RemainingHours
                </div>

                <div class="text-muted small mt-1">
                    Contract hours remaining
                </div>

            </div>

        </div>

    </div>


    <div class="col-6 col-xl-3">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">

                <div class="text-muted small fw-semibold text-uppercase mb-2">
                    Utilisation
                </div>

                <div class="fs-2 fw-bold">
                    @Model.Utilisation%
                </div>

                <div class="text-muted small mt-1">
                    Weekly schedule usage
                </div>

            </div>

        </div>

    </div>

</div>


<!-- WORKLOAD -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h5 class="fw-bold mb-1">
                    Workload
                </h5>

                <p class="text-muted small mb-0">
                    Scheduled hours compared with contract hours.
                </p>

            </div>

            <span class="fw-semibold">
                @Model.Utilisation%
            </span>

        </div>


        <div class="progress"
             style="height: 12px;">

            <div class="progress-bar
                @(Model.Utilisation >= 100 ? "bg-danger" :
                    Model.Utilisation >= 90 ? "bg-success" :
                    "bg-warning")"
                 role="progressbar"
                 style="width:@Math.Min(Model.Utilisation, 100)%"
                 aria-valuenow="@Model.Utilisation"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>

        </div>

        @if (Model.Utilisation > 100)
        {
            <div class="text-danger small mt-2 fw-semibold">
                Employee is scheduled above their contracted hours.
            </div>
        }

    </div>

</div>


<!-- UPCOMING SHIFTS -->

<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white border-0 p-4 pb-3">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h5 class="fw-bold mb-1">
                    Upcoming Shifts
                </h5>

                <p class="text-muted small mb-0">
                    Scheduled shifts from today onwards.
                </p>

            </div>

            <span class="badge bg-primary-subtle text-primary border px-3 py-2">
                @upcomingShifts.Count
            </span>

        </div>

    </div>


    <div class="card-body p-0">

        @if (upcomingShifts.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 employee-shift-table">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Date
                            </th>

                            <th>
                                Time
                            </th>

                            <th>
                                Break
                            </th>

                            <th>
                                Hours
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var shift in upcomingShifts)
                        {
                            <tr>

                                <td class="ps-4">

                                    <div class="fw-semibold">
                                        @shift.StartTime.ToString("ddd dd MMM")
                                    </div>

                                </td>


                                <td>

                                    <span class="fw-medium">

                                        @shift.StartTime.ToString("HH:mm")
                                        -
                                        @shift.EndTime.ToString("HH:mm")

                                    </span>

                                </td>


                                <td>

                                    <span class="text-muted">
                                        @shift.BreakDuration mins
                                    </span>

                                </td>


                                <td>

                                    <span class="badge bg-light text-dark border">

                                        @shift.ShiftHours hrs

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5 px-3">

                <div class="shift-empty-icon mb-3">
                    ✓
                </div>

                <h6 class="fw-bold mb-1">
                    No upcoming shifts
                </h6>

                <p class="text-muted small mb-0">
                    This employee currently has no shifts scheduled.
                </p>

            </div>
        }

    </div>

</div>


<!-- ACTIONS -->

<div class="card border-0 shadow-sm">

    <div class="card-body p-4">

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Availability"
               asp-action="Index"
               asp-route-employeeId="@Model.EmployeeID"
               class="btn btn-primary">

                Manage Availability

            </a>


            <a asp-controller="HolidayRequest"
               asp-action="Create"
               asp-route-employeeId="@Model.EmployeeID"
               class="btn btn-outline-warning">

                Request Holiday

            </a>


            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Back To Employees

            </a>

        </div>

    </div>

</div>


<style>

    .employee-profile-avatar {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        font-weight: 700;
    }

    .employee-shift-table th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #6c757d;
        font-weight: 650;
        white-space: nowrap;
    }

    .employee-shift-table td {
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .shift-empty-icon {
        width: 46px;
        height: 46px;
        margin: 0 auto;
        border-radius: 50%;
        background: #e9f7ef;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
    }

</style>